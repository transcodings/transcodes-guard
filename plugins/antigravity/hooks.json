{
  "//": "MVP persona only — gate hooks commented out. To restore, move _disabled.transcodes-guard-stepup to the top level.",
  "_disabled": {
    "transcodes-guard-stepup": {
      "PreToolUse": [
        {
          "matcher": "run_command|mcp_.*|call_mcp_tool",
          "hooks": [
            {
              "type": "command",
              "command": "node __PLUGIN_DIR__/dist/hooks/pre-tool-use.js",
              "timeout": 30
            }
          ]
        }
      ],
      "PreInvocation": [
        {
          "type": "command",
          "command": "node __PLUGIN_DIR__/dist/hooks/pre-invocation.js",
          "timeout": 10
        }
      ],
      "Stop": [
        {
          "type": "command",
          "command": "node __PLUGIN_DIR__/dist/hooks/stop.js",
          "timeout": 10
        }
      ]
    }
  }
}
