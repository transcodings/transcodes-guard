{
  "name": "@bigstrider/transcodes-cli",
  "version": "0.19.6",
  "description": "Transcodes CLI — manage transcodes-guard member tokens and the step-up gate (set/reset/status/tokens, enable/disable, dashboard).",
  "type": "module",
  "bin": {
    "transcodes": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsup && chmod 755 dist/index.js",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "tsx --test test/*.test.*",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@toon-format/toon": "^4.0.0",
    "es-toolkit": "^1.49.0",
    "globby": "^16.2.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@transcodes-guard/core": "*",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "FSL-1.1-ALv2"
}
